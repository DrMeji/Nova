{
  "name": "nova",
  "private": true,
  "version": "0.1.317",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "NOVA — AI Creation Studio desktop app",
  "author": "DrMeji",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrMeji/Nova-Source.git"
  },
  "homepage": "https://github.com/DrMeji/Nova/releases",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-env-for-build.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "temp-nova": "npm --prefix temp-nova start",
    "temp-nova:install": "npm --prefix temp-nova install",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && node scripts/electron-dev-launch.cjs\"",
    "electron:start": "npm run build && node_modules/electron/dist/electron.exe .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:dir": "npm run build && electron-builder --dir",
    "electron:publish": "npm run build && electron-builder --publish always",
    "smoke:ui": "node scripts/smoke-ui.cjs",
    "smoke:launch": "node scripts/smoke-launch.cjs",
    "smoke:packaged": "node scripts/smoke-packaged.cjs",
    "smoke:brain": "node scripts/smoke-brain-check.cjs",
    "smoke:delete": "npx tsx --tsconfig tsconfig.app.json scripts/smoke-delete-flow.mjs",
    "smoke:routes": "npx tsx --tsconfig tsconfig.app.json scripts/smoke-chat-routes.mjs",
    "smoke:agent-loop": "npx tsx --tsconfig tsconfig.app.json scripts/smoke-agent-loop.mjs",
    "smoke:agent-eval": "npx tsx --tsconfig tsconfig.app.json scripts/smoke-agent-loop-eval.mjs",
    "smoke:catalog": "node scripts/smoke-catalog-ssot.cjs",
    "smoke:secrets": "node scripts/smoke-secrets-check.cjs",
    "smoke:parked": "tsx --tsconfig tsconfig.app.json scripts/smoke-parked-features.mjs",
    "smoke:file-ops": "tsx --tsconfig tsconfig.app.json scripts/smoke-file-ops.mjs",
    "smoke:self-guard": "tsx --tsconfig tsconfig.app.json scripts/smoke-self-guard.mjs",
    "smoke:thread-brain": "node scripts/smoke-thread-brain.cjs",
    "smoke:cloud-wiring": "tsx --tsconfig tsconfig.app.json scripts/smoke-cloud-wiring.mjs",
    "smoke:followup": "tsx --tsconfig tsconfig.app.json scripts/smoke-followup-intent.mjs",
    "smoke:social-demo": "tsx --tsconfig tsconfig.app.json scripts/smoke-social-demo-packaged.mjs",
    "smoke:failover-matrix": "tsx --tsconfig tsconfig.app.json scripts/smoke-failover-matrix.mjs",
    "smoke:voice-refuse": "tsx --tsconfig tsconfig.app.json scripts/smoke-voice-refuse.mjs",
    "smoke:app-twins": "tsx --tsconfig tsconfig.app.json scripts/smoke-app-twins.mjs",
    "smoke:interactive-depth": "tsx --tsconfig tsconfig.app.json scripts/smoke-interactive-depth.mjs",
    "smoke:midbuild-switch": "tsx --tsconfig tsconfig.app.json scripts/smoke-midbuild-switch.mjs",
    "smoke:no-brain-nudge": "tsx --tsconfig tsconfig.app.json scripts/smoke-no-brain-nudge.mjs",
    "smoke:ready-gates": "tsx --tsconfig tsconfig.app.json scripts/smoke-ready-gates.mjs",
    "smoke:ui-polish-floor": "tsx --tsconfig tsconfig.app.json scripts/check-ui-polish-floor.mjs",
    "smoke:create-quality": "tsx --tsconfig tsconfig.app.json scripts/smoke-create-quality.mjs",
    "smoke:design-spine": "tsx --tsconfig tsconfig.app.json scripts/smoke-design-spine.mjs",
    "smoke:storefront": "tsx --tsconfig tsconfig.app.json scripts/smoke-storefront-contract.mjs",
    "smoke:product-plan": "tsx --tsconfig tsconfig.app.json scripts/_smoke-product-plan.mjs",
    "smoke:create-pass-spine": "tsx --tsconfig tsconfig.app.json scripts/smoke-create-pass-spine.mjs",
    "smoke:single-brain-create": "tsx --tsconfig tsconfig.app.json scripts/smoke-single-brain-create.mjs",
    "smoke:ensemble-parked": "tsx --tsconfig tsconfig.app.json scripts/check-ensemble-parked.mjs",
    "smoke:syntax-gate-tipjar": "tsx --tsconfig tsconfig.app.json scripts/check-syntax-gate-tipjar.mjs",
    "smoke:tool-craft-contract": "tsx --tsconfig tsconfig.app.json scripts/check-tool-craft-contract.mjs",
    "smoke:design-ladder": "tsx --tsconfig tsconfig.app.json scripts/live-design-ladder.mjs",
    "smoke:create-evidence": "tsx --tsconfig tsconfig.app.json scripts/smoke-create-evidence.mjs",
    "smoke:permanent-create": "tsx --tsconfig tsconfig.app.json scripts/smoke-permanent-create.mjs",
    "smoke:create-identity": "tsx --tsconfig tsconfig.app.json scripts/smoke-create-identity.mjs",
    "smoke:create-intent": "tsx --tsconfig tsconfig.app.json scripts/check-create-intent.mjs",
    "smoke:classify-turn": "tsx --tsconfig tsconfig.app.json scripts/check-classify-turn.mjs",
    "smoke:dispatch-contract": "tsx --tsconfig tsconfig.app.json scripts/check-dispatch-no-answerstudio.mjs",
    "smoke:dispatch-hosts": "tsx --tsconfig tsconfig.app.json scripts/check-dispatch-hosts.mjs",
    "smoke:create-reply": "npx tsx --tsconfig tsconfig.app.json scripts/check-create-reply.mjs",
    "smoke:edit-weak": "npx tsx --tsconfig tsconfig.app.json scripts/check-edit-weak-no-hop.mjs",
    "smoke:verify-ask": "tsx --tsconfig tsconfig.app.json scripts/check-verify-ask.mjs",
    "smoke:brain-profile": "tsx --tsconfig tsconfig.app.json scripts/check-brain-profile.mjs",
    "smoke:auth-heal": "tsx --tsconfig tsconfig.app.json scripts/check-auth-session-heal.mjs",
    "smoke:preview-session": "tsx --tsconfig tsconfig.app.json scripts/smoke-preview-session.mjs",
    "smoke:bind-isolation": "tsx --tsconfig tsconfig.app.json scripts/smoke-bind-isolation.mjs",
    "smoke:react-import-heal": "tsx --tsconfig tsconfig.app.json scripts/smoke-react-import-heal.mjs",
    "smoke:stretch-owners": "tsx --tsconfig tsconfig.app.json scripts/smoke-stretch-owners.mjs",
    "smoke:public-harden": "tsx --tsconfig tsconfig.app.json scripts/smoke-public-harden.mjs",
    "smoke:version-lock": "node scripts/check-version-lock.mjs",
    "smoke:answer-contract": "tsx --tsconfig tsconfig.app.json scripts/smoke-answer-contract.mjs",
    "smoke:chat-model-picker": "tsx --tsconfig tsconfig.app.json scripts/smoke-chat-model-picker.mjs",
    "smoke:chat-spine": "tsx --tsconfig tsconfig.app.json scripts/smoke-chat-spine.mjs",
    "smoke:overview-vs-debug": "tsx --tsconfig tsconfig.app.json scripts/smoke-overview-vs-debug.mjs",
    "smoke:bulk-chat-delete": "tsx --tsconfig tsconfig.app.json scripts/smoke-bulk-chat-delete.mjs",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build"
  },
  "dependencies": {
    "@dev.icons/react": "^1.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "edge-tts-universal": "^1.4.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.1",
    "wait-on": "^8.0.1",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.nova.studio",
    "productName": "NOVA",
    "executableName": "NOVA",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/icon.ico",
      "!electron/**/*.md",
      "!**/*.map",
      "!**/._*",
      "!website/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "build/icon.ico",
      "build/icon.png"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "differentialPackage": true,
      "shortcutName": "NOVA",
      "uninstallDisplayName": "NOVA",
      "artifactName": "NOVA-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DrMeji",
        "repo": "Nova",
        "releaseType": "release"
      }
    ]
  }
}
