{
  "name": "ark",
  "private": true,
  "version": "0.1.160",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "ARK \u00e2\u20ac\u201d AI Creation Studio desktop app",
  "author": "DrMeji",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrMeji/Ark-Source.git"
  },
  "homepage": "https://github.com/DrMeji/Ark/releases",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && set ARK_DEV=1 && node_modules/electron/dist/electron.exe .\"",
    "electron:start": "npm run build && node_modules/electron/dist/electron.exe .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:dir": "npm run build && electron-builder --dir",
    "electron:publish": "npm run build && electron-builder --publish always",
    "smoke:ui": "node scripts/smoke-ui.cjs",
    "smoke:brain": "node scripts/smoke-brain-check.cjs",
    "smoke:delete": "npx tsx --tsconfig tsconfig.app.json scripts/smoke-delete-flow.mjs",
    "smoke:routes": "npx tsx --tsconfig tsconfig.app.json scripts/smoke-chat-routes.mjs",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.2.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ark.studio",
    "productName": "ARK",
    "executableName": "ARK",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/icon.ico",
      "!electron/**/*.md",
      "!**/*.map",
      "!**/._*",
      "!website/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "build/icon.ico",
      "build/icon.png"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "differentialPackage": true,
      "shortcutName": "ARK",
      "uninstallDisplayName": "ARK",
      "artifactName": "ARK-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DrMeji",
        "repo": "Ark",
        "releaseType": "release"
      }
    ]
  }
}
