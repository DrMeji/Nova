# Code signing for ARK Windows installer (electron-builder)
#
# A paid Authenticode certificate (EV or OV from DigiCert, Sectigo, SSL.com, etc.)
# makes Windows SmartScreen trust ARK-Setup.exe on first run.
#
# 1) Buy / install a code-signing cert as a .pfx (or hardware token).
# 2) In PowerShell before Open-ARK-Packaged.bat / npm run electron:build:
#
#   set CSC_LINK=C:\path\to\certificate.pfx
#   set CSC_KEY_PASSWORD=your-cert-password
#
# Optional:
#   set CSC_IDENTITY_AUTO_DISCOVERY=false
#   set WIN_CSC_LINK=...   (same as CSC_LINK on Windows)
#
# electron-builder picks these up automatically — never commit secrets.
#
# Verify after build (PowerShell):
#   Get-AuthenticodeSignature .\release\ARK-Setup.exe
#   Status should be Valid when the cert is trusted.
#
# Without signing, SmartScreen may warn. Signing is required before wide distribution.
#
# Plugin OAuth client ids (optional, for one-click device login):
#   set ARK_GITHUB_CLIENT_ID=your_oauth_app_client_id
#   set ARK_GOOGLE_CLIENT_ID=...
#   set ARK_GOOGLE_CLIENT_SECRET=...
#   set ARK_BRAIN_TOKEN=optional_bearer_for_lindsay
