# Code signing for ARK Windows installer (electron-builder)
#
# Set these in your shell before Open-ARK-Packaged.bat / npm run electron:build:
#
#   set CSC_LINK=C:\path\to\certificate.pfx
#   set CSC_KEY_PASSWORD=your-cert-password
#
# Optional:
#   set CSC_IDENTITY_AUTO_DISCOVERY=false
#
# electron-builder picks these up automatically — do not put secrets in package.json.
#
# Without signing, Windows SmartScreen may warn on first run. Signing is required
# before wide distribution.
