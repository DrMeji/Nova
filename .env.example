# Copy to .env.local (or .env) for local Vite. Never commit real secrets.
# Anon key is public-by-design for client apps; still keep service role out of the repo.

# Supabase project URL (https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon / publishable key (safe for the browser; RLS must protect data)
VITE_SUPABASE_ANON_KEY=
